# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Claude Code agent-isolation scratch space. Other contents of .claude/
# (commands, agents, settings) are intentionally tracked.
.claude/worktrees/

# Cartog code-intelligence database
.cartog.db
.cartog.db-shm
.cartog.db-wal

# Python bytecode (skill scripts under .agents/ run Python — Python
# leaves __pycache__/*.pyc next to each module on import)
__pycache__/
*.pyc

# Node (mirror/, cf-dispatcher/)
node_modules/
*.log
npm-debug.log*

# Cloudflare Workers local state (cf-dispatcher/)
.wrangler/
.dev.vars

# Stale Electron-era artifacts at repo root (kept ignored to prevent
# accidental re-add). Subdirectories — mac/, mirror/ — keep their own.
/package.json
/package-lock.json
/pnpm-lock.yaml
/dist/
/node_modules/
