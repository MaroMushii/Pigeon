{
  "name": "pigeon-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Pigeon's Cloudflare Worker. Scrapes Telegram channels and commits JSON snapshots to the export branch for Pigeon to read.",
  "type": "module",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "trigger": "wrangler triggers deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
